# --- App ---
ENV=development

# --- Database (docker-compose 서비스명 기준) ---
POSTGRES_USER=ongil
POSTGRES_PASSWORD=ongil
POSTGRES_DB=ongil_tour
DATABASE_URL=postgresql+psycopg2://ongil:ongil@db:5432/ongil_tour

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- JWT (이다영 담당, 확정되면 값만 교체) ---
JWT_SECRET_KEY=changeme
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- External APIs ---
KAKAO_REST_API_KEY=
KAKAO_JS_KEY=
TOUR_API_KEY=
TOUR_API_BASE_URL=https://apis.data.go.kr/B551011/KorService2

# --- OAuth (이다영 담당) ---
# 구글/카카오/네이버 전부 프론트가 네이티브 SDK로 로그인을 끝내고 토큰만 넘겨주는
# 방식이라, 백엔드는 인가 코드 교환용 client_secret/redirect_uri가 필요 없음.
# GOOGLE_CLIENT_ID만 idToken의 aud claim 검증(다른 앱 토큰 도용 방지)에 사용.
GOOGLE_CLIENT_ID=